# benchmark artifacts
# Downloaded SBML is reproducible from the manifest + checksums, so it is not vendored.
benchmark/models/
# Transient build scratch and logs (leading underscore = not a frozen artifact).
benchmark/data/_*
# Human-review exports are working records, not frozen benchmark artifacts.
benchmark/phase3/error_audit/review_work/
# Release archives are build artifacts; their digests are recorded in benchmark/dist/*.md.
benchmark/dist/*.zip
**/BioModels_251106
# Phase 3 live-response cache (never commit API payloads).
benchmark/phase3/_*/
# Phase 3 retrieval model/embedding caches (large and reproducible).
benchmark/phase3/retrieval_baselines/_*/
# Phase 3B model snapshots, optimizer checkpoints, rankings, and isolated env.
benchmark/phase3/phase3b_smoke/_*/
benchmark/phase3/phase3b_smoke/_*
# Phase 3B full-run model/checkpoint/embedding scratch.
benchmark/phase3/phase3b_full/_*
# Phase 3C raw Responses API cache; committed artifacts are scrubbed derivatives.
benchmark/phase3/phase3c_smoke/_*/
# Phase 3C paired-validation raw cache, attempt ledger, and resumable scratch.
benchmark/phase3/phase3c_validation/_*
