# Frozen benchmark artifacts carry SHA-256 digests in benchmark/data/VERSION.json.
# Those digests are computed over LF-terminated files, so line endings must survive
# checkout unchanged on every platform or the digests will not verify.
benchmark/data/*.csv text eol=lf
benchmark/data/*.json text eol=lf
# The release manifests are regenerated and diffed byte-for-byte, so they need the same
# treatment even though they live outside benchmark/data/.
benchmark/*.json text eol=lf
benchmark/manifest/*.txt text eol=lf
benchmark/manifest/*.json text eol=lf
benchmark/phase3/*.csv text eol=lf
benchmark/phase3/*.json text eol=lf
benchmark/phase3/*.jsonl text eol=lf
benchmark/phase3/phase3b_full/*.json text eol=lf
benchmark/phase3/phase3b_full/*.jsonl text eol=lf
benchmark/phase3/phase3b_full/*.md text eol=lf

# Phase 4 checksum manifests record exact generated bytes, including newlines.
benchmark/phase4/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Matplotlib path data intentionally contain trailing spaces inside attributes.
benchmark/phase4/**/*.svg -whitespace
benchmark/PHASE4.md -text
benchmark/requirements-phase4.txt -text
benchmark/scripts/phase4_*.py -text
tests/test_phase4_*.py -text

# Phase 5 source/state and artifact manifests also use exact byte checksums.
benchmark/phase5/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
benchmark/phase5/**/*.svg -whitespace
benchmark/PHASE5.md -text whitespace=cr-at-eol
benchmark/scripts/phase5_*.py -text whitespace=cr-at-eol
tests/test_phase5_*.py -text whitespace=cr-at-eol
goals.md -text whitespace=cr-at-eol
